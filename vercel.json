{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR_API_DOMAIN/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}